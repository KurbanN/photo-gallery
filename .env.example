# --- Legacy single event (ваша свадьба без кабинета) ---
LEGACY_EVENT_SLUG=main
LEGACY_EVENT_TITLE=Живая лента
LEGACY_EVENT_SUBTITLE=Kurban & Fatima · введите код с карточки
LEGACY_LOGIN_BG=/login-bg.jpg
EVENT_PIN=2026

# Публичный URL приложения (для QR и ссылок в кабинете)
# GitHub Pages (репозиторий photo-gallery):
APP_PUBLIC_URL=https://kurbann.github.io/photo-gallery

# Администраторы платформы (через запятую). Им выдаётся role=admin автоматически при входе.
PLATFORM_ADMIN_EMAILS=dunga309@gmail.com

# CORS (через запятую). Пусто = разрешить все origins
ALLOWED_ORIGINS=https://kurbann.github.io,https://kurbann.github.io/photo-gallery

# --- Браузер (Vite) — локально и/или GitHub Actions Variables при сборке Pages ---
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# URL бэкенда (Express). На GitHub Pages — Railway/Render; иначе public/app-config.json → apiBaseUrl
VITE_API_BASE_URL=https://your-api.example.com
# Публичный URL фронта (magic link). На Pages — тот же, что APP_PUBLIC_URL:
VITE_APP_URL=https://kurbann.github.io/photo-gallery

# Для GitHub Pages без Variables: скопируйте public/app-config.example.json → app-config.json
# (только publishable key — он публичный; service_role сюда НЕ класть)

# Кабинет: вход по email + пароль (без magic link).
# Supabase → Authentication → Providers → Email: включите Email, снимите «Confirm email» — иначе после регистрации нужно письмо.

# --- Сервер ---
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=wedding-photos
PORT=8787
MAX_FILE_MB=40
